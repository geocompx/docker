{
	"name": "Geocomputation with R",
	"image": "ghcr.io/geocompx/minimal:latest",
	"customizations": {
		"vscode": {
			"settings": {
				"r.sessionWatcher": true,
				"r.plot.backend": "auto",
				"r.bracketedPaste": true,
				"r.interactive.executionTarget": "terminal"
			},
			"extensions": [
				"REditorSupport.r",
				"quarto.quarto",
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
